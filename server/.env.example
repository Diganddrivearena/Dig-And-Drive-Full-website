# Fast2SMS — WhatsApp order confirmation (https://www.fast2sms.com → Dev API → WhatsApp Manager)
FAST2SMS_API_KEY=
# Run: npm run fast2sms:status — auto-fills these after WhatsApp Manager onboarding
FAST2SMS_WHATSAPP_PHONE_NUMBER_ID=
# Approved UTILITY template message_id (vars: name|orderId|items|total)
FAST2SMS_ORDER_MESSAGE_ID=
# Shop owner gets Quick SMS on every paid order (10-digit Indian mobile)
FAST2SMS_ADMIN_NUMBER=
# Optional: also send customer a Quick SMS ("true" / omit)
FAST2SMS_SEND_SMS=

