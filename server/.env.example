BETTER_AUTH_TRUSTED_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
API_PORT=8787
VITE_API_URL=/api
VITE_RAZORPAY_KEY_ID=
